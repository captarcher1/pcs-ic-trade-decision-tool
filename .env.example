# ─────────────────────────────────────────────────────────────────────────────
# PCS / Iron Condor Trade Decisioning Tool — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it contains real API keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data Source ───────────────────────────────────────────────────────────────
# Choose which provider to use for market data.
# Options: yfinance | finnhub | alphavantage | polygon
#
# yfinance:      Free, no key needed. Covers ETFs/stocks + VIX (^VIX).
#                No economic calendar. Index spot (SPX, NDX) NOT available.
#
# finnhub:       Free tier key required. Real-time quotes + economic calendar.
#                Best overall free option if you want the eco-calendar panel.
#
# alphavantage:  Free key required. Quotes + daily OHLCV for ATR.
#                No economic calendar. Rate-limited on free tier (5 req/min).
#
# polygon:       Paid key required. Real-time data, options chain.
#                Economic calendar requires Starter+ plan.

DATA_SOURCE=yfinance

# ── API Keys ──────────────────────────────────────────────────────────────────
# Only the key for your chosen DATA_SOURCE is required.
# Leave unused keys blank — they will be ignored.

# Finnhub — https://finnhub.io (free tier available)
FINNHUB_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key (free)
ALPHA_VANTAGE_API_KEY=

# Polygon.io — https://polygon.io/dashboard (paid)
POLYGON_API_KEY=

# ── Flask Server ──────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_DEBUG=false
